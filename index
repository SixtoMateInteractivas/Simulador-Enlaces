<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Quantum Chem - Configuración Electrónica Interactiva</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        c1s: '#EF4444', // Rojo
                        c2s: '#F97316', // Naranja
                        c2p: '#10B981', // Verde
                        c3s: '#06B6D4', // Cian
                        c3p: '#3B82F6', // Azul
                        c4s: '#8B5CF6', // Púrpura
                        c3d: '#EC4899', // Rosa
                    },
                    animation: {
                        'shake': 'shake 0.4s cubic-bezier(.36,.07,.19,.97) both',
                        'glow-pulse': 'glowPulse 1.5s infinite alternate',
                    },
                    keyframes: {
                        shake: {
                            '10%, 90%': { transform: 'translate3d(-2px, 0, 0)' },
                            '20%, 80%': { transform: 'translate3d(4px, 0, 0)' },
                            '30%, 50%, 70%': { transform: 'translate3d(-5px, 0, 0)' },
                            '40%, 60%': { transform: 'translate3d(5px, 0, 0)' },
                        },
                        glowPulse: {
                            '0%': { boxShadow: '0 0 5px rgba(56, 189, 248, 0.4)' },
                            '100%': { boxShadow: '0 0 18px rgba(56, 189, 248, 0.9)' }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Touch scroll behavior optimization for mobile */
        body {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #020617;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }
        .box-flash {
            animation: glowPulse 1s infinite alternate;
        }
        .box-error {
            animation: shake 0.4s ease-in-out;
            border-color: #ef4444 !important;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.8) !important;
        }
        /* Draggable Electron Styling */
        .draggable-electron {
            cursor: grab;
            touch-action: none;
            transition: transform 0.1s ease, box-shadow 0.2s ease;
        }
        .draggable-electron:active {
            cursor: grabbing;
            transform: scale(1.25);
            z-index: 100;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans bg-slate-950 text-slate-100 overflow-x-hidden selection:bg-sky-500 selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900/90 border-b border-slate-800 sticky top-0 z-40 backdrop-blur">
        <div class="max-w-7xl mx-auto px-3 py-2.5 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20">
                    <i class="fa-solid fa-atom text-xl animate-spin" style="animation-duration: 8s;"></i>
                </div>
                <div>
                    <h1 class="text-base font-extrabold bg-gradient-to-r from-sky-400 to-indigo-300 bg-clip-text text-transparent leading-none">
                        QuantumChem
                    </h1>
                    <p class="text-[10px] text-slate-400 font-medium">Configuración Electrónica</p>
                </div>
            </div>

            <!-- Level Switcher Buttons (Mobile Friendly) -->
            <div class="flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs">
                <button id="tabLvl1" onclick="switchLevel(1)" class="px-2.5 py-1.5 rounded-lg font-semibold transition-all text-sky-400 bg-slate-800 shadow">
                    Nivel 1
                </button>
                <button id="tabLvl2" onclick="switchLevel(2)" class="px-2.5 py-1.5 rounded-lg font-semibold transition-all text-slate-400 hover:text-slate-200">
                    Nivel 2
                </button>
                <button id="tabLvl3" onclick="switchLevel(3)" class="px-2.5 py-1.5 rounded-lg font-semibold transition-all text-slate-400 hover:text-slate-200">
                    Nivel 3
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container Layout -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-3 md:p-5 grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- LEFT COLUMN: Target Info, Animated Bohr Canvas & Written Notation (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-4">
            
            <!-- Element Header Card -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-xl flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div id="targetCardSymbol" class="w-14 h-14 rounded-xl bg-slate-950 border-2 border-sky-500/60 flex flex-col items-center justify-center font-mono shadow-inner">
                        <span id="cardZ" class="text-[10px] font-bold text-sky-400 self-start ml-1.5 -mb-1">Z=?</span>
                        <span id="cardSymbol" class="text-xl font-black text-white">?</span>
                    </div>
                    <div>
                        <h2 id="cardName" class="text-base font-bold text-slate-100">Cargando...</h2>
                        <span id="lvlDescription" class="text-xs text-sky-400 font-medium">Nivel 1: Modelo de Bohr (Z = 1 - 10)</span>
                    </div>
                </div>

                <div class="text-right">
                    <button onclick="generateRandomGame()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 active:scale-95 border border-slate-700 rounded-lg text-xs font-semibold text-slate-200 transition-all flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-dice text-sky-400"></i> Otro
                    </button>
                    <div class="mt-2 text-[11px] font-mono text-slate-400">
                        Electrones: <span id="electronCounter" class="text-amber-400 font-bold">0/0</span>
                    </div>
                </div>
            </div>

            <!-- Animated Bohr Canvas View -->
            <div id="canvasContainer" class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col items-center justify-center relative overflow-hidden min-h-[280px] sm:min-h-[320px]">
                <div class="absolute top-3 left-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-1.5 z-10">
                    <i class="fa-solid fa-atom text-sky-400"></i> Modelo Átomico Animado
                </div>

                <!-- Canvas for spinning electrons and drop target -->
                <canvas id="bohrCanvas" width="300" height="300" class="max-w-full h-auto my-2 touch-none relative z-0"></canvas>

                <div class="w-full flex items-center justify-between text-[11px] text-slate-400 px-2 z-10">
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block"></span> K (n=1)</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> L (n=2)</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span> M (n=3)</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span> N (n=4)</span>
                </div>
            </div>

            <!-- Real-time Written Spectroscopic Notation -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-3.5 shadow-xl">
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2 flex items-center justify-between">
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-pen-nib text-indigo-400"></i> Notación Espectroscópica</span>
                    <span class="text-[10px] text-slate-500 font-mono">Sincronización en tiempo real</span>
                </div>
                <div id="writtenNotation" class="font-mono text-sm sm:text-base bg-slate-950 p-3 rounded-xl border border-slate-800 min-h-[46px] flex flex-wrap items-center gap-1.5 text-sky-300">
                    <!-- Dynamic Notation Span -->
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: Level Specific Workspaces (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-4">

            <!-- Toast / Alert Floating Message -->
            <div id="toastAlert" class="hidden p-3 rounded-xl border bg-red-950/90 border-red-800 text-red-200 text-xs sm:text-sm font-medium flex items-center justify-between shadow-xl animate-shake">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 text-base"></i>
                    <span id="toastText">¡Error!</span>
                </div>
                <button onclick="hideToast()" class="text-slate-400 hover:text-white px-2 py-0.5">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- LEVEL 1 WORKSPACE: Bohr Shell Construction -->
            <div id="workspaceLvl1" class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col justify-between flex-1">
                <div>
                    <h3 class="text-sm font-bold text-slate-200 mb-1 flex items-center gap-2">
                        <i class="fa-solid fa-hand-pointer text-sky-400"></i> Nivel 1: Arrastre a Capas en Movimiento
                    </h3>
                    <p class="text-xs text-slate-400 mb-3">Arrastra los electrones desde el repositorio y suéltalos directamente sobre los anillos en rotación dentro del Canvas.</p>

                    <!-- Interactive Electron Drag Pool -->
                    <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 mb-4 flex flex-col gap-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-300">Repositorio de Electrones (Arrastrables):</span>
                            <span id="reserveCount" class="text-xs font-mono font-bold text-amber-400">0 e⁻ disponibles</span>
                        </div>
                        <div id="electronPool" class="flex flex-wrap gap-2.5 min-h-[52px] p-2 bg-slate-900/80 rounded-lg border border-slate-800/80 items-center justify-start">
                            <!-- Draggable electron items generated dynamically -->
                        </div>
                    </div>

                    <!-- Shell Status Cards -->
                    <div class="space-y-2">
                        <div id="shellK_card" class="p-2.5 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-between transition-all">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-red-500"></span>
                                <span class="font-bold text-xs">Capa K (n=1, máx 2)</span>
                            </div>
                            <span id="shellK_text" class="font-mono text-xs text-sky-300 font-bold">0 / 2 e⁻</span>
                        </div>

                        <div id="shellL_card" class="p-2.5 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-between transition-all">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                                <span class="font-bold text-xs">Capa L (n=2, máx 8)</span>
                            </div>
                            <span id="shellL_text" class="font-mono text-xs text-sky-300 font-bold">0 / 8 e⁻</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center text-xs">
                    <button onclick="resetCurrentLevel()" class="text-slate-400 hover:text-slate-200 flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> Reiniciar Capas
                    </button>
                    <span id="lvl1Status" class="text-sky-400 font-semibold text-[11px]">Suelta el e⁻ sobre la órbita deseada</span>
                </div>
            </div>

            <!-- LEVEL 2 WORKSPACE: Quantum Subshells & Box Diagram -->
            <div id="workspaceLvl2" class="hidden bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col justify-between flex-1">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                            <i class="fa-solid fa-boxes-stacked text-emerald-400"></i> Nivel 2: Diagrama de Cajas de Orbitales
                        </h3>
                        <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700 font-mono">Z = 11 al 30</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-3">Toca cualquier caja para alternar su estado. El primer electrón adopta espín <b class="text-sky-400">↑</b> y el segundo <b class="text-amber-400">↓</b> automáticamente.</p>

                    <!-- Orbital Box Rows Container -->
                    <div id="orbitalBoxesContainer" class="space-y-2.5 max-h-[420px] overflow-y-auto pr-1">
                        <!-- Rendered dynamically -->
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
                    <button onclick="resetCurrentLevel()" class="text-slate-400 hover:text-slate-200 flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> Vaciar Cajas
                    </button>
                    <span id="lvl2Status" class="text-slate-400 font-mono">Sin violaciones detectadas</span>
                </div>
            </div>

            <!-- LEVEL 3 WORKSPACE: Inverse Mode (Deduction via Periodic Table) -->
            <div id="workspaceLvl3" class="hidden bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col justify-between flex-1">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                            <i class="fa-solid fa-magnifying-glass text-purple-400"></i> Nivel 3: Modo Inverso de Deducción
                        </h3>
                        <span class="text-[10px] bg-purple-900/50 text-purple-300 border border-purple-700/50 px-2 py-0.5 rounded font-mono">Deduce el Elemento Incógnito</span>
                    </div>
                    <p class="text-xs text-slate-400 mb-3">Observa el diagrama de cajas ya completo a la izquierda/abajo e identifica a qué elemento químico corresponde en la tabla periódica.</p>

                    <!-- Revealed Box Diagram for Deduction -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 mb-4">
                        <span class="text-[11px] font-semibold text-slate-400 block mb-2">Configuración Cuántica Incógnita:</span>
                        <div id="lvl3RevealedBoxes" class="flex flex-wrap gap-2 justify-start max-h-[160px] overflow-y-auto">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <!-- Interactive Simplified Periodic Table Grid -->
                    <div class="space-y-1">
                        <span class="text-[11px] font-semibold text-slate-400 block mb-1">Selecciona el elemento correcto en la tabla periódica:</span>
                        <div id="periodicGrid" class="grid grid-cols-6 sm:grid-cols-10 gap-1 max-h-[220px] overflow-y-auto p-1 bg-slate-950 rounded-xl border border-slate-800">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs">
                    <span id="lvl3Hint" class="text-slate-400 text-[11px]">Cuenta el número total de electrones ($\sum e^-$) para determinar $Z$.</span>
                </div>
            </div>

        </div>

    </main>

    <!-- Modal Success Notification -->
    <div id="successModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-6 text-center shadow-2xl transform transition-all">
            <div class="w-14 h-14 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-3 border border-emerald-500/40">
                <i class="fa-solid fa-trophy animate-bounce"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">¡Excelente Trabajo!</h3>
            <p id="successModalBody" class="text-xs text-slate-300 mb-5">Has completado la configuración electrónica del elemento de forma impecable.</p>
            <button onclick="generateRandomGame(); hideSuccessModal();" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs transition-all shadow-lg shadow-sky-500/20">
                Siguiente Elemento
            </button>
        </div>
    </div>

    <!-- Application Script Logic -->
    <script>
        /**
         * COLOR TOKENS MANDATE
         */
        const SUBSHELL_COLORS = {
            '1s': { hex: '#EF4444', class: 'border-red-500/60 bg-red-950/20 text-red-400' },
            '2s': { hex: '#F97316', class: 'border-orange-500/60 bg-orange-950/20 text-orange-400' },
            '2p': { hex: '#10B981', class: 'border-emerald-500/60 bg-emerald-950/20 text-emerald-400' },
            '3s': { hex: '#06B6D4', class: 'border-cyan-500/60 bg-cyan-950/20 text-cyan-400' },
            '3p': { hex: '#3B82F6', class: 'border-blue-500/60 bg-blue-950/20 text-blue-400' },
            '4s': { hex: '#8B5CF6', class: 'border-purple-500/60 bg-purple-950/20 text-purple-400' },
            '3d': { hex: '#EC4899', class: 'border-pink-500/60 bg-pink-950/20 text-pink-400' }
        };

        const SHELL_RADII = { K: 45, L: 75, M: 102, N: 128 };
        const SHELL_COLORS = { K: '#EF4444', L: '#10B981', M: '#3B82F6', N: '#8B5CF6' };

        /**
         * ELEMENTS DATABASE (Z=1 to 30)
         */

        /* ... existing database code ... */
        const ELEMENTS = [
            { z: 1, symbol: 'H', name: 'Hidrógeno' },
            { z: 2, symbol: 'He', name: 'Helio' },
            { z: 3, symbol: 'Li', name: 'Litio' },
            { z: 4, symbol: 'Be', name: 'Berilio' },
            { z: 5, symbol: 'B', name: 'Boro' },
            { z: 6, symbol: 'C', name: 'Carbono' },
            { z: 7, symbol: 'N', name: 'Nitrógeno' },
            { z: 8, symbol: 'O', name: 'Oxígeno' },
            { z: 9, symbol: 'F', name: 'Flúor' },
            { z: 10, symbol: 'Ne', name: 'Neón' },
            { z: 11, symbol: 'Na', name: 'Sodio' },
            { z: 12, symbol: 'Mg', name: 'Magnesio' },
            { z: 13, symbol: 'Al', name: 'Aluminio' },
            { z: 14, symbol: 'Si', name: 'Silicio' },
            { z: 15, symbol: 'P', name: 'Fósforo' },
            { z: 16, symbol: 'S', name: 'Azufre' },
            { z: 17, symbol: 'Cl', name: 'Cloro' },
            { z: 18, symbol: 'Ar', name: 'Argón' },
            { z: 19, symbol: 'K', name: 'Potasio' },
            { z: 20, symbol: 'Ca', name: 'Calcio' },
            { z: 21, symbol: 'Sc', name: 'Escandio' },
            { z: 22, symbol: 'Ti', name: 'Titanio' },
            { z: 23, symbol: 'V', name: 'Vanadio' },
            { z: 24, symbol: 'Cr', name: 'Cromo' },
            { z: 25, symbol: 'Mn', name: 'Manganeso' },
            { z: 26, symbol: 'Fe', name: 'Hierro' },
            { z: 27, symbol: 'Co', name: 'Cobalto' },
            { z: 28, symbol: 'Ni', name: 'Níquel' },
            { z: 29, symbol: 'Cu', name: 'Cobre' },
            { z: 30, symbol: 'Zn', name: 'Zinc' }
        ];

        const SUBSHELLS = [
            { name: '1s', boxes: 1, cap: 2, level: 1 },
            { name: '2s', boxes: 1, cap: 2, level: 2 },
            { name: '2p', boxes: 3, cap: 6, level: 2 },
            { name: '3s', boxes: 1, cap: 2, level: 3 },
            { name: '3p', boxes: 3, cap: 6, level: 3 },
            { name: '4s', boxes: 1, cap: 2, level: 4 },
            { name: '3d', boxes: 5, cap: 10, level: 3 }
        ];

        // GAME STATE
        let currentLevel = 1;
        let currentElement = ELEMENTS[0];
        let bohrShells = { K: 0, L: 0, M: 0, N: 0 };
        let orbitalState = {};
        let animationAngle = 0;

        // Pointer/Drag state for Level 1
        let draggingElectron = null;
        let dragOffset = { x: 0, y: 0 };

        // DOM ELEMENTS
        const bohrCanvas = document.getElementById('bohrCanvas');
        const ctx = bohrCanvas.getContext('2d');

        window.addEventListener('DOMContentLoaded', () => {
            initOrbitalState();
            generateRandomGame();
            renderPeriodicGrid();
            startAnimationLoop();
            initLevel1PointerDrag();
        });

        function initOrbitalState() {
            orbitalState = {};
            SUBSHELLS.forEach(sub => {
                orbitalState[sub.name] = new Array(sub.boxes).fill(0);
            });
        }

        function switchLevel(lvl) {
            currentLevel = lvl;
            [1, 2, 3].forEach(i => {
                const tab = document.getElementById(`tabLvl${i}`);
                const ws = document.getElementById(`workspaceLvl${i}`);
                if (i === lvl) {
                    tab.className = "px-2.5 py-1.5 rounded-lg font-semibold transition-all text-sky-400 bg-slate-800 shadow";
                    ws.classList.remove('hidden');
                } else {
                    tab.className = "px-2.5 py-1.5 rounded-lg font-semibold transition-all text-slate-400 hover:text-slate-200";
                    ws.classList.add('hidden');
                }
            });

            const desc = document.getElementById('lvlDescription');
            if (lvl === 1) desc.textContent = "Nivel 1: Arrastre a Capas en Movimiento (Z = 1 - 10)";
            else if (lvl === 2) desc.textContent = "Nivel 2: Diagrama de Cajas (Z = 11 - 30)";
            else desc.textContent = "Nivel 3: Modo Inverso de Deducción";

            generateRandomGame();
        }

        function generateRandomGame() {
            hideToast();
            let minZ = 1, maxZ = 10;
            if (currentLevel === 2) { minZ = 11; maxZ = 30; }
            if (currentLevel === 3) { minZ = 1; maxZ = 30; }

            const filtered = ELEMENTS.filter(e => e.z >= minZ && e.z <= maxZ);
            currentElement = filtered[Math.floor(Math.random() * filtered.length)];

            bohrShells = { K: 0, L: 0, M: 0, N: 0 };
            initOrbitalState();

            if (currentLevel === 3) {
                document.getElementById('cardSymbol').textContent = '?';
                document.getElementById('cardZ').textContent = 'Z=?';
                document.getElementById('cardName').textContent = 'Elemento Incógnito';
                autoFillCorrectBoxesForCurrentElement();
                renderLvl3RevealedBoxes();
            } else {
                document.getElementById('cardSymbol').textContent = currentElement.symbol;
                document.getElementById('cardZ').textContent = `Z=${currentElement.z}`;
                document.getElementById('cardName').textContent = currentElement.name;
            }

            if (currentLevel === 1) renderElectronPool();
            if (currentLevel === 2) renderOrbitalWorkspaceLvl2();

            updateGlobalCounters();
            renderWrittenNotation();
        }

        function resetCurrentLevel() {
            bohrShells = { K: 0, L: 0, M: 0, N: 0 };
            initOrbitalState();
            hideToast();
            if (currentLevel === 1) renderElectronPool();
            if (currentLevel === 2) renderOrbitalWorkspaceLvl2();
            updateGlobalCounters();
            renderWrittenNotation();
        }

        /**
         * LEVEL 1: Electron Pool Rendering & Pointer Drag Events
         */
        function renderElectronPool() {
            const pool = document.getElementById('electronPool');
            pool.innerHTML = '';
            const placed = bohrShells.K + bohrShells.L + bohrShells.M + bohrShells.N;
            const remaining = currentElement.z - placed;

            for (let i = 0; i < remaining; i++) {
                const eItem = document.createElement('div');
                eItem.className = 'draggable-electron w-8 h-8 rounded-full bg-gradient-to-tr from-sky-500 to-indigo-500 border-2 border-white/80 shadow-lg flex items-center justify-center font-mono font-bold text-[10px] text-white select-none';
                eItem.innerHTML = 'e⁻';
                pool.appendChild(eItem);
            }

            if (remaining === 0) {
                pool.innerHTML = '<span class="text-xs text-emerald-400 font-semibold italic">¡Todos los electrones asignados!</span>';
            }
        }

        function initLevel1PointerDrag() {
            document.addEventListener('pointerdown', (e) => {
                if (currentLevel !== 1) return;
                const target = e.target.closest('.draggable-electron');
                if (!target) return;

                draggingElectron = target;
                const rect = target.getBoundingClientRect();
                dragOffset.x = e.clientX - rect.left;
                dragOffset.y = e.clientY - rect.top;

                target.style.position = 'fixed';
                target.style.left = `${e.clientX - dragOffset.x}px`;
                target.style.top = `${e.clientY - dragOffset.y}px`;
                target.style.zIndex = '9999';
                document.body.appendChild(target);

                if (target.setPointerCapture) {
                    target.setPointerCapture(e.pointerId);
                }
            });

            document.addEventListener('pointermove', (e) => {
                if (!draggingElectron) return;
                draggingElectron.style.left = `${e.clientX - dragOffset.x}px`;
                draggingElectron.style.top = `${e.clientY - dragOffset.y}px`;
            });

            document.addEventListener('pointerup', (e) => {
                if (!draggingElectron) return;
                const canvasRect = bohrCanvas.getBoundingClientRect();
                const dropX = e.clientX;
                const dropY = e.clientY;

                // Check if dropped within Canvas
                if (
                    dropX >= canvasRect.left &&
                    dropX <= canvasRect.right &&
                    dropY >= canvasRect.top &&
                    dropY <= canvasRect.bottom
                ) {
                    const canvasCenterX = canvasRect.left + canvasRect.width / 2;
                    const canvasCenterY = canvasRect.top + canvasRect.height / 2;
                    const distFromCenter = Math.hypot(dropX - canvasCenterX, dropY - canvasCenterY);

                    // Map distance to nearest shell radius (scaled to actual canvas display)
                    const scale = canvasRect.width / bohrCanvas.width;
                    const droppedRadius = distFromCenter / scale;

                    handleElectronDropOnCanvas(droppedRadius);
                }

                // Cleanup dragged element
                if (draggingElectron && draggingElectron.parentNode) {
                    draggingElectron.parentNode.removeChild(draggingElectron);
                }
                draggingElectron = null;
                renderElectronPool();
            });
        }

        function handleElectronDropOnCanvas(droppedRadius) {
            hideToast();

            // Find closest shell ring to the drop point
            let closestShell = null;
            let minDiff = Infinity;

            ['K', 'L'].forEach(shellKey => {
                const diff = Math.abs(droppedRadius - SHELL_RADII[shellKey]);
                if (diff < minDiff) {
                    minDiff = diff;
                    closestShell = shellKey;
                }
            });

            // Tolerance radius threshold
            if (minDiff > 32) {
                showToast("Suelta el electrón más cerca de los anillos K o L en movimiento.");
                return;
            }

            // Validate Aufbau rules
            if (closestShell === 'L' && bohrShells.K < 2 && currentElement.z > 2) {
                showToast("¡Violación de Aufbau! Debes llenar primero la Capa K (2 e⁻) antes de agregar a la Capa L.");
                flashElement('shellK_card');
                return;
            }

            if (closestShell === 'K' && bohrShells.K >= 2) {
                showToast("La Capa K está llena (máx 2 e⁻). Intenta colocarlo en la Capa L.");
                flashElement('shellL_card');
                return;
            }

            if (closestShell === 'L' && bohrShells.L >= 8) {
                showToast("La Capa L ha alcanzado su capacidad máxima (8 e⁻).");
                return;
            }

            // Assign electron to shell
            bohrShells[closestShell]++;
            updateGlobalCounters();
            renderWrittenNotation();

            if (bohrShells.K + bohrShells.L === currentElement.z) {
                showSuccessModal(`¡Excelente! Has acomodado todos los electrones en las órbitas en movimiento del **${currentElement.name}**.`);
            }
        }

        /**
         * LEVEL 2 LOGIC & RENDERERS
         */
        function renderOrbitalWorkspaceLvl2() {
            const container = document.getElementById('orbitalBoxesContainer');
            container.innerHTML = '';

            SUBSHELLS.forEach(sub => {
                const row = document.createElement('div');
                const colInfo = SUBSHELL_COLORS[sub.name];
                row.className = `p-3 rounded-xl border ${colInfo.class} flex items-center justify-between gap-2`;

                const title = document.createElement('div');
                title.className = 'w-16 font-mono font-bold text-sm';
                title.textContent = sub.name;

                const boxesDiv = document.createElement('div');
                boxesDiv.className = 'flex items-center gap-2 flex-1 justify-start';

                for (let b = 0; b < sub.boxes; b++) {
                    const val = orbitalState[sub.name][b];
                    const btn = document.createElement('button');
                    btn.id = `box_${sub.name}_${b}`;
                    btn.className = `w-10 h-12 bg-slate-950 border-2 rounded-lg flex items-center justify-center font-mono text-lg transition-all active:scale-95 shadow-inner ${val > 0 ? 'border-sky-400 text-sky-300' : 'border-slate-700 text-slate-600'}`;
                    btn.onclick = () => onBoxClickLvl2(sub.name, b);
                    btn.innerHTML = getBoxArrowSymbol(val);
                    boxesDiv.appendChild(btn);
                }

                row.appendChild(title);
                row.appendChild(boxesDiv);
                container.appendChild(row);
            });
        }

        function getBoxArrowSymbol(val) {
            if (val === 1) return '<span class="text-sky-400 font-bold">↑</span>';
            if (val === 2) return '<span class="text-amber-400 font-bold">↓</span>';
            if (val === 3) return '<span class="text-sky-400 font-bold">↑</span><span class="text-amber-400 font-bold">↓</span>';
            return '<span class="text-slate-800 text-xs">vacío</span>';
        }

        function onBoxClickLvl2(subName, boxIdx) {
            hideToast();
            let currentVal = orbitalState[subName][boxIdx];
            let nextVal = (currentVal + 1) % 4;

            // 1. AUFBAU
            const subIdx = SUBSHELLS.findIndex(s => s.name === subName);
            for (let i = 0; i < subIdx; i++) {
                const prevSub = SUBSHELLS[i];
                const prevCount = getSubshellCount(prevSub.name);
                if (prevCount < prevSub.cap) {
                    showToast(`¡Violación de Aufbau! Debes llenar completamente el orbital ${prevSub.name} antes de ocupar ${subName}. ${subName==='3d'?'¡Recuerda que 4s se llena antes que 3d!':''}`);
                    triggerBoxError(`box_${subName}_${boxIdx}`);
                    return;
                }
            }

            // 2. HUND
            const subConfig = SUBSHELLS[subIdx];
            if (subConfig.boxes > 1 && (nextVal === 3 || nextVal === 2)) {
                const hasEmptyBox = orbitalState[subName].some((v, idx) => idx !== boxIdx && v === 0);
                if (hasEmptyBox && nextVal === 3) {
                    showToast(`¡Violación de la Regla de Hund! En subniveles ${subName}, debes colocar un electrón (↑) en cada caja antes de emparejar.`);
                    triggerBoxError(`box_${subName}_${boxIdx}`);
                    return;
                }
            }

            orbitalState[subName][boxIdx] = nextVal;
            renderOrbitalWorkspaceLvl2();
            updateGlobalCounters();
            renderWrittenNotation();

            if (getTotalOrbitalElectrons() === currentElement.z) {
                showSuccessModal(`¡Excelente! Has construido la configuración exacta del **${currentElement.name}** (Z=${currentElement.z}).`);
            }
        }

        function getSubshellCount(subName) {
            return orbitalState[subName].reduce((acc, val) => {
                if (val === 1 || val === 2) return acc + 1;
                if (val === 3) return acc + 2;
                return acc;
            }, 0);
        }

        function getTotalOrbitalElectrons() {
            return SUBSHELLS.reduce((sum, sub) => sum + getSubshellCount(sub.name), 0);
        }

        /**
         * LEVEL 3 LOGIC
         */
        function autoFillCorrectBoxesForCurrentElement() {
            initOrbitalState();
            let rem = currentElement.z;

            for (let sub of SUBSHELLS) {
                if (rem <= 0) break;
                const toPlace = Math.min(rem, sub.cap);
                if (toPlace <= sub.boxes) {
                    for (let b = 0; b < toPlace; b++) orbitalState[sub.name][b] = 1;
                } else {
                    for (let b = 0; b < sub.boxes; b++) orbitalState[sub.name][b] = 1;
                    const pairs = toPlace - sub.boxes;
                    for (let b = 0; b < pairs; b++) orbitalState[sub.name][b] = 3;
                }
                rem -= toPlace;
            }
        }

        function renderLvl3RevealedBoxes() {
            const container = document.getElementById('lvl3RevealedBoxes');
            container.innerHTML = '';

            SUBSHELLS.forEach(sub => {
                const count = getSubshellCount(sub.name);
                if (count > 0) {
                    const badge = document.createElement('div');
                    const colInfo = SUBSHELL_COLORS[sub.name];
                    badge.className = `p-2 rounded-lg border ${colInfo.class} font-mono text-xs flex items-center gap-1.5`;
                    badge.innerHTML = `<b>${sub.name}:</b> ` + orbitalState[sub.name].map(v => `[${getBoxArrowSymbol(v)}]`).join('');
                    container.appendChild(badge);
                }
            });
        }

        function renderPeriodicGrid() {
            const grid = document.getElementById('periodicGrid');
            grid.innerHTML = '';

            ELEMENTS.forEach(elem => {
                const btn = document.createElement('button');
                btn.className = 'p-2 bg-slate-900 border border-slate-800 rounded-lg hover:border-sky-400 font-mono text-xs flex flex-col items-center justify-center transition-all active:scale-90';
                btn.innerHTML = `<span class="text-[9px] text-slate-500">${elem.z}</span><b class="text-sky-300">${elem.symbol}</b>`;
                btn.onclick = () => checkLvl3Guess(elem);
                grid.appendChild(btn);
            });
        }

        function checkLvl3Guess(selectedElem) {
            if (selectedElem.z === currentElement.z) {
                showSuccessModal(`¡Correcto! La configuración pertenécía al **${currentElement.name} (${currentElement.symbol})** con Z=${currentElement.z}.`);
            } else {
                showToast(`Incorrecto. El ${selectedElem.name} tiene Z=${selectedElem.z}. Revisa la suma de electrones.`);
            }
        }

        /**
         * COUNTERS & NOTATION
         */
        function updateGlobalCounters() {
            let placed = 0;
            if (currentLevel === 1) {
                placed = bohrShells.K + bohrShells.L + bohrShells.M + bohrShells.N;
                document.getElementById('reserveCount').textContent = `${currentElement.z - placed} e⁻ disponibles`;
                document.getElementById('shellK_text').textContent = `${bohrShells.K} / 2 e⁻`;
                document.getElementById('shellL_text').textContent = `${bohrShells.L} / 8 e⁻`;
            } else {
                placed = getTotalOrbitalElectrons();
            }

            document.getElementById('electronCounter').textContent = `${placed}/${currentElement.z}`;
        }

        function renderWrittenNotation() {
            const notationDiv = document.getElementById('writtenNotation');
            notationDiv.innerHTML = '';
            let hasAny = false;

            if (currentLevel === 1) {
                if (bohrShells.K > 0) {
                    hasAny = true;
                    notationDiv.innerHTML += `<span class="mr-2"><b style="color:${SUBSHELL_COLORS['1s'].hex}">1s</b><sup>${bohrShells.K}</sup></span>`;
                }
                if (bohrShells.L > 0) {
                    hasAny = true;
                    const sL = Math.min(2, bohrShells.L);
                    const pL = Math.max(0, bohrShells.L - 2);
                    notationDiv.innerHTML += `<span class="mr-2"><b style="color:${SUBSHELL_COLORS['2s'].hex}">2s</b><sup>${sL}</sup></span>`;
                    if (pL > 0) notationDiv.innerHTML += `<span class="mr-2"><b style="color:${SUBSHELL_COLORS['2p'].hex}">2p</b><sup>${pL}</sup></span>`;
                }
            } else {
                SUBSHELLS.forEach(sub => {
                    const count = getSubshellCount(sub.name);
                    if (count > 0) {
                        hasAny = true;
                        notationDiv.innerHTML += `<span class="mr-2"><b style="color:${SUBSHELL_COLORS[sub.name].hex}">${sub.name}</b><sup>${count}</sup></span>`;
                    }
                });
            }

            if (!hasAny) {
                notationDiv.innerHTML = '<span class="text-slate-600 italic text-xs">Arrastra o haz clic para colocar electrones...</span>';
            }
        }

        /**
         * BOHR ANIMATED CANVAS LOOP
         */
        function startAnimationLoop() {
            function animate() {
                animationAngle += 0.015;
                drawAnimatedBohrModel();
                requestAnimationFrame(animate);
            }
            animate();
        }

        function drawAnimatedBohrModel() {
            ctx.clearRect(0, 0, bohrCanvas.width, bohrCanvas.height);
            const cx = bohrCanvas.width / 2;
            const cy = bohrCanvas.height / 2;

            // Nucleus
            ctx.beginPath();
            ctx.arc(cx, cy, 22, 0, 2 * Math.PI);
            ctx.fillStyle = '#0284c7';
            ctx.fill();
            ctx.lineWidth = 2;
            ctx.strokeStyle = '#38bdf8';
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 11px Outfit, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(currentLevel === 3 ? '+?' : `+${currentElement.z}`, cx, cy);

            let shellCounts = { K: 0, L: 0, M: 0, N: 0 };
            if (currentLevel === 1) {
                shellCounts = { ...bohrShells };
            } else {
                SUBSHELLS.forEach(sub => {
                    const cnt = getSubshellCount(sub.name);
                    if (sub.level === 1) shellCounts.K += cnt;
                    if (sub.level === 2) shellCounts.L += cnt;
                    if (sub.level === 3) shellCounts.M += cnt;
                    if (sub.level === 4) shellCounts.N += cnt;
                });
            }

            Object.keys(shellCounts).forEach((shellKey, idx) => {
                const count = shellCounts[shellKey];
                const radius = SHELL_RADII[shellKey];
                const color = SHELL_COLORS[shellKey];

                // Orbit Ring
                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, 2 * Math.PI);
                ctx.strokeStyle = count > 0 ? color : 'rgba(148, 163, 184, 0.25)';
                ctx.lineWidth = count > 0 ? 2 : 1.5;
                ctx.setLineDash(count > 0 ? [] : [4, 4]);
                ctx.stroke();
                ctx.setLineDash([]);

                // Rotating Electrons
                const speedMult = 1 - (idx * 0.15);
                for (let i = 0; i < count; i++) {
                    const angle = animationAngle * speedMult + (i * 2 * Math.PI / count);
                    const ex = cx + radius * Math.cos(angle);
                    const ey = cy + radius * Math.sin(angle);

                    ctx.beginPath();
                    ctx.arc(ex, ey, 5.5, 0, 2 * Math.PI);
                    ctx.fillStyle = color;
                    ctx.fill();
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                }
            });
        }

        /**
         * UI HELPERS
         */
        function showToast(msg) {
            const t = document.getElementById('toastAlert');
            document.getElementById('toastText').textContent = msg;
            t.classList.remove('hidden');
        }

        function hideToast() {
            document.getElementById('toastAlert').classList.add('hidden');
        }

        function triggerBoxError(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                el.classList.add('box-error');
                setTimeout(() => el.classList.remove('box-error'), 400);
            }
        }

        function flashElement(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                el.classList.add('box-flash');
                setTimeout(() => el.classList.remove('box-flash'), 1200);
            }
        }

        function showSuccessModal(msg) {
            document.getElementById('successModalBody').innerHTML = msg;
            document.getElementById('successModal').classList.remove('hidden');
        }

        function hideSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
        }
    </script>

</body>
